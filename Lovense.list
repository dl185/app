# Lovense Remote + Lovense Connect + VibeMate
# Mihomo classical rule-provider format: rule type and payload only.
# Direct exceptions for lovense.club are configured before this provider in ACL4SSR_.yaml.

# ===== Local LAN Game Mode =====
DOMAIN-SUFFIX,lovense.club
DOMAIN-KEYWORD,lovense.club

# ===== VibeMate =====
DOMAIN-SUFFIX,vibemate.com
DOMAIN,surfease.vibemate.com
DOMAIN,cdn.vibemate.com
DOMAIN,www.vibemate.com
DOMAIN,event.vibemate.com
DOMAIN,preview.vibemate.com
DOMAIN,vibemate-web-push.vibemate.com
DOMAIN,vibemate-web-push-test.vibemate.com

# ===== Official Lovense services =====
DOMAIN-SUFFIX,lovense.com
DOMAIN-SUFFIX,lovense-api.com
DOMAIN,api.lovense.com
DOMAIN,api.lovense-api.com
DOMAIN,apps.lovense.com
DOMAIN,app.lovense.com
DOMAIN,cdn.lovense.com
DOMAIN,coll.lovense.com
DOMAIN,developer.lovense.com
DOMAIN,developers.lovense.com
DOMAIN,support.lovense.com
DOMAIN,studio.lovense.com
DOMAIN,guide.lovense.com
DOMAIN,log.lovense.com
DOMAIN,survey.lovense.com
DOMAIN,affiliate.lovense.com
DOMAIN,partners.lovense.com
DOMAIN,activity.lovense-api.com
DOMAIN,apps.lovense-api.com

# ===== Keyword fallbacks =====
DOMAIN-KEYWORD,vibemate
DOMAIN-KEYWORD,surfease
DOMAIN-KEYWORD,lovense
